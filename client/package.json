  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "5.11.10",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "13.5.0",
    "react-scripts": "5.0.1"
  }
