  "version": "1.0.3",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bootstrap": "4.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "5.2.0",
    "web-vitals": "1.1.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "overrides": {
