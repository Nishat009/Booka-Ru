REACT_APP_API_URL=http://localhost:5500
# true = show the one-click demo login buttons in a production build (demo deployment only; the API needs DEMO_MODE=true).
REACT_APP_DEMO_LOGINS=false
# Optional Google Maps Embed API key. Without a key, the Dhaka OpenStreetMap embed is used.
REACT_APP_GOOGLE_MAPS_API_KEY=
