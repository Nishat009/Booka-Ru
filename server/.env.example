PORT=5500
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
DB_NAME=bookDB
# Sign up with this email to receive the first administrator account.
ADMIN_EMAIL=admin@example.com
# Enable role demo buttons only for local development; the API disables them in production.
ENABLE_DEMO_LOGINS=false
# Development only. Set these before running `npm run seed:demo`.
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=
DEMO_CUSTOMER_PASSWORD=
