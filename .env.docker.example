# Copy to .env in the project root before `docker compose up`. Never commit .env.

# Signing up (or seeding) with this email gives the administrator account.
ADMIN_EMAIL=admin@example.com
DB_NAME=bookDB

# Public address of the API as the visitor's browser sees it (no trailing slash).
# Local machine: http://localhost:5500   Server: https://api.your-domain.com
PUBLIC_API_URL=http://localhost:5500

# Host ports.
API_PORT=5500
WEB_PORT=8080

# Optional. Without a key the OpenStreetMap embed is used.
REACT_APP_GOOGLE_MAPS_API_KEY=

# Optional, demo databases only: passwords for `npm run db:seed` demo accounts.
# 8+ characters including a number. Choose your own; leave empty in production.
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=
DEMO_CUSTOMER_PASSWORD=
